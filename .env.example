# =============================================================================
# Begônia Ateliê — variáveis de ambiente
#
# Copie este arquivo para .env.local (desenvolvimento) e cadastre os mesmos
# nomes em Vercel > Project > Settings > Environment Variables (produção).
#
# NUNCA versione o .env.local nem cole estes valores em arquivo do navegador.
# Só MP_PUBLIC_KEY pode ser visto pelo cliente, e mesmo ela é entregue pelo
# endpoint /api/config, não escrita no HTML.
# =============================================================================


# -----------------------------------------------------------------------------
# GATEWAY DE PAGAMENTO
#
# Escolhe qual provedor processa as cobranças.
#   infinitepay  -> Pix e crédito, link único (EM USO)
#   mercadopago  -> Pix, crédito e débito
#   simulado     -> só desenvolvimento, aprova sozinho, não cobra ninguém
# -----------------------------------------------------------------------------

# OPCIONAL: backend/config.js já usa "infinitepay" por padrão. Defina aqui
# só para trocar de provedor ou apontar para o simulado em desenvolvimento.
GATEWAY=infinitepay


# -----------------------------------------------------------------------------
# INFINITEPAY  (obrigatório quando GATEWAY=infinitepay)
#
# Onde pegar: é a InfiniteTag da conta — o "@" que aparece no app InfinitePay,
# em Perfil. Pode colar com ou sem o cifrão.
#
# Atenção: a API da InfinitePay não usa chave secreta. A conta é identificada
# só por esta tag, que é pública. Não há credencial para rotacionar, e por
# isso a segurança do fluxo se apoia na conferência do pedido e do valor
# feita em api/webhook.js.
#
# Antes de funcionar, a cliente precisa HABILITAR o Checkout Integrado no
# app da InfinitePay.
# -----------------------------------------------------------------------------

# OPCIONAL: o padrão "begoniaatelie" está em backend/config.js, versionado de
# propósito — a InfiniteTag é pública e não autoriza nada sozinha, então o site
# sobe vendendo mesmo sem ninguém cadastrar variável em painel nenhum.
INFINITEPAY_HANDLE=begoniaatelie


# -----------------------------------------------------------------------------
# MERCADO PAGO  (só se GATEWAY=mercadopago)
#
# Onde pegar: mercadopago.com.br -> Seu negócio -> Configurações ->
# Gestão e administração -> Credenciais.
# -----------------------------------------------------------------------------

# Access token — SEGREDO. Fica só no servidor.
# MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# MP_MODO=teste
# MP_WEBHOOK_SECRET=cole-aqui-a-chave-secreta-do-webhook
# MP_MAX_PARCELAS=6
# PIX_EXPIRA_MINUTOS=30


# -----------------------------------------------------------------------------
# E-MAIL  (obrigatório para a dona ser avisada dos pedidos)
#
# Onde pegar: resend.com → crie a conta → "API Keys" → "Create API Key".
# Antes de enviar de verdade, verifique seu domínio em "Domains".
# Enquanto o domínio não estiver verificado, use onboarding@resend.dev como
# remetente — ele só entrega para o e-mail dono da conta Resend.
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_0000000000000000000000000

# Remetente. Precisa ser de um domínio verificado no Resend.
EMAIL_REMETENTE=Begônia Ateliê <pedidos@begoniaatelie.com.br>

# Para onde vai o aviso de pedido pago. É a caixa que a dona lê todo dia.
EMAIL_DONA=dona@begoniaatelie.com.br

# Recibo automático para quem comprou. Ponha "false" para desligar.
ENVIAR_RECIBO_CLIENTE=true


# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------

# Endereço público, sem barra no fim. Usado nos retornos do pagamento, no
# webhook e na liberação de CORS. Na Vercel, se você não definir, o sistema
# usa VERCEL_URL automaticamente — mas com domínio próprio, defina aqui.
SITE_URL=https://begoniaatelie.com.br


# -----------------------------------------------------------------------------
# HISTÓRICO DE PEDIDOS  (opcional, mas recomendado)
#
# Sem isto, o site continua vendendo, porém o pedido não fica registrado entre
# uma execução e outra — e a trava que evita e-mail duplicado perde a memória.
#
# Onde pegar: painel da Vercel → aba "Storage" → "Create Database" →
# "Upstash for Redis". Ao conectar ao projeto, a Vercel cadastra
# KV_REST_API_URL e KV_REST_API_TOKEN sozinha.
# -----------------------------------------------------------------------------

KV_REST_API_URL=https://sua-instancia.upstash.io
KV_REST_API_TOKEN=cole-aqui-o-token-do-upstash

# Dias que os dados pessoais do pedido ficam guardados (LGPD).
RETENCAO_PEDIDOS_DIAS=180

# Só para desenvolvimento. Em produção NÃO defina isto: sem Redis de verdade,
# o histórico morre a cada execução da função e o desconto de primeira compra
# passaria a valer sempre.
# HISTORICO_EM_MEMORIA=true


# -----------------------------------------------------------------------------
# AVISO POR WHATSAPP  (preparado, desligado)
#
# O link wa.me já vai dentro do e-mail para a dona. Envio automático exige um
# provedor que mande mensagem sem alguém clicar. Quando tiver, descomente o
# bloco no fim de api/_lib/notificacao.js e preencha estas duas.
# -----------------------------------------------------------------------------

# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
