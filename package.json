{
  "name": "begonia-atelie",
  "version": "1.0.0",
  "description": "Site da Begônia Ateliê — boutique artesanal de crochê, tricô e macramê.",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/css/input.css -o ./css/site.css --minify",
    "watch": "tailwindcss -i ./src/css/input.css -o ./css/site.css --watch",
    "dev": "npm run build && node dev-server.js",
    "serve": "node dev-server.js",
    "start": "npm run build && npm run serve",
    "vercel-build": "npm run build",
    "dev:api": "npm run build && vercel dev --listen 4321",
    "teste:api": "node testes/api.test.js",
    "serve:estatico": "http-server . -p 4321 -c-1 -o",
    "teste:infinitepay": "node testes/infinitepay.test.js",
    "teste": "npm run teste:api && npm run teste:infinitepay"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "http-server": "^14.1.1",
    "tailwindcss": "^4.1.11"
  }
}
